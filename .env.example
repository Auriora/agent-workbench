# Source/development analytics configuration. Official packages contain their
# own defaults; set AGENT_WORKBENCH_ANALYTICS_ENABLED=false to opt out.
AGENT_WORKBENCH_ANALYTICS_ENABLED=false
AGENT_WORKBENCH_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
AGENT_WORKBENCH_POSTHOG_HOST=https://eu.i.posthog.com

# Optional privacy-bounded operational logs. This remains off unless explicitly enabled.
AGENT_WORKBENCH_POSTHOG_LOGS_ENABLED=false
